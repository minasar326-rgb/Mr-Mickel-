  "edge_side_panel": {
    "preferred_width": 400
  },
  "note_taking": {
    "new_note_url": "./#notes"
  },
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "name": "ملفات منصة مستر مايكل شحاتة",
      "icons": [
        {
          "src": "./icons/icon-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ],
      "accept": {
        "application/pdf": [".pdf"],
        "text/plain": [".txt"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+mrmichael",
      "url": "./?url=%s"
    }
  ],
  "scope_extensions": [
    {
      "origin": "https://minasar326-rgb.github.io"
    }
  ],
  "widgets": [
    {
      "name": "منصة مستر مايكل شحاتة",
