rules_version = '2';

// ===============================================================
// Hardened Security Rules: Mr. Michael Shehata LMS
// Protection against unauthorized admin access, lecture tampering,
// code forgery, and subscription bypass.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Teacher Admin verification: matches authorized admin emails, UIDs, or custom claims
    function isTeacherAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in [
          'teacher@gmail.com',
          'mrmichaelshehata@gmail.com',
          'admin@themaster.com',
          'saryanymina@gmail.com'
        ] ||
        request.auth.uid == 'teacher-admin' ||
        request.auth.token.admin == true
      );
    }

    // ===============================================================
    // Users & Students Collections
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isTeacherAdmin();
      allow create, update: if isOwner(userId) || isTeacherAdmin();
      allow delete: if isTeacherAdmin();

      match /subscriptions/{subId} {
        allow read: if isOwner(userId) || isTeacherAdmin();
        allow write: if isTeacherAdmin();
      }
    }

    match /students/{userId} {
      allow read: if isOwner(userId) || isTeacherAdmin();
      allow create, update: if isOwner(userId) || isTeacherAdmin();
      allow delete: if isTeacherAdmin();

      match /subscriptions/{subId} {
        allow read: if isOwner(userId) || isTeacherAdmin();
        allow write: if isTeacherAdmin();
      }
    }

    // ===============================================================
    // Subscriptions Collection
    // ===============================================================

    match /subscriptions/{subId} {
      // Students can only read their own active subscriptions
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isTeacherAdmin());
      
      // Subscriptions can only be created by Teacher Admin or valid code activation
      allow create: if isTeacherAdmin() || (
        isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'active'
      );
      
      // Only Teacher Admin can modify or delete existing subscriptions
      allow update, delete: if isTeacherAdmin();
    }

    // ===============================================================
    // Courses & Lectures (Curriculum Protection)
    // ===============================================================

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isTeacherAdmin();

      match /lectures/{lectureId} {
        allow read: if true;
        allow write: if isTeacherAdmin();
      }
    }

    match /lectures/{lectureId} {
      allow read: if true;
      allow write: if isTeacherAdmin();
    }

    // ===============================================================
    // Activation & Subscription Codes
    // ===============================================================

    match /codes/{codeId} {
      // Only authenticated users can query/verify a code
      allow read: if isAuthenticated();
      // Only Teacher Admin can generate or delete codes
      allow create, delete: if isTeacherAdmin();
      // An authenticated student can only mark an unused code as used by themselves
      allow update: if isTeacherAdmin() || (
        isAuthenticated() &&
        resource.data.isUsed != true &&
        request.resource.data.isUsed == true &&
        request.resource.data.usedByUid == request.auth.uid
      );
    }

    match /subscriptionCodes/{codeId} {
      allow read: if isAuthenticated();
      allow create, delete: if isTeacherAdmin();
      allow update: if isTeacherAdmin() || (
        isAuthenticated() &&
        resource.data.isUsed != true &&
        request.resource.data.isUsed == true &&
        request.resource.data.usedByUid == request.auth.uid
      );
    }

    // ===============================================================
    // Public Content & Platform Configurations
    // ===============================================================

    match /settings/{docId} {
      allow read: if true;
      allow write: if isTeacherAdmin();
    }

    match /booklets/{docId} {
      allow read: if true;
      allow write: if isTeacherAdmin();
    }

    match /achievers/{docId} {
      allow read: if true;
      allow write: if isTeacherAdmin();
    }

    match /announcements/{docId} {
      allow read: if true;
      allow write: if isTeacherAdmin();
    }

    // ===============================================================
    // Attendance Logs
    // ===============================================================

    match /attendanceLogs/{logId} {
      allow read: if isTeacherAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
