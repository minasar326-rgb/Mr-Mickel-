rules_version = '2';

// ===============================================================
// Hardened Security Rules: Mr. Michael Shehata LMS (The Master)
// Production Security Model with Strict Custom Claims & Zero-Trust Client
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Teacher Admin verification: matches custom claim role == 'teacher' or super_admin
    function isTeacher() {
      return isAuthenticated() && (
        request.auth.token.role == 'teacher' ||
        request.auth.token.role == 'instructor' ||
        request.auth.token.role == 'super_admin' ||
        request.auth.token.admin == true ||
        request.auth.token.email in [
          'mrmichaelshehata@gmail.com',
          'teacher@gmail.com',
          'admin@themaster.com',
          'sareanymina@gmail.com',
          'saryanymina@gmail.com'
        ]
      );
    }

    // Protect sensitive fields from being self-assigned by students
    function doesNotModifySensitiveFields() {
      let sensitive = ['subscriptions', 'role', 'isFrozen', 'isPaused', 'subscription', 'subscriptionStatus', 'xpPoints'];
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(sensitive);
    }

    function doesNotSetSensitiveFieldsOnCreate() {
      let sensitive = ['subscriptions', 'role', 'isFrozen', 'isPaused', 'subscription', 'subscriptionStatus'];
      return !request.resource.data.keys().hasAny(sensitive);
    }

    // ===============================================================
    // Users & Students Collections
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isTeacher();
      allow create: if (isOwner(userId) && doesNotSetSensitiveFieldsOnCreate()) || isTeacher();
      allow update: if (isOwner(userId) && doesNotModifySensitiveFields()) || isTeacher();
      allow delete: if isTeacher();

      match /subscriptions/{subId} {
        allow read, write: if isOwner(userId) || isTeacher();
      }
    }

    match /students/{userId} {
      allow read: if isOwner(userId) || isTeacher();
      allow create: if (isOwner(userId) && doesNotSetSensitiveFieldsOnCreate()) || isTeacher();
      allow update: if (isOwner(userId) && doesNotModifySensitiveFields()) || isTeacher();
      allow delete: if isTeacher();

      match /subscriptions/{subId} {
        allow read, write: if isOwner(userId) || isTeacher();
      }
    }

    // ===============================================================
    // Subscriptions Collection (Top-Level)
    // ===============================================================

    match /subscriptions/{subId} {
      // Students can only read their own subscription documents
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isTeacher());
      allow write: if (isAuthenticated() && request.resource.data.userId == request.auth.uid) || isTeacher();
    }

    // ===============================================================
    // Activation Codes (Single Lookup for Redemption, List for Teacher)
    // ===============================================================

    match /codes/{codeId} {
      allow get: if isAuthenticated();
      allow list: if isTeacher();
      allow update: if (isAuthenticated() && (resource.data.usedCount < resource.data.maxUses || resource.data.usedByUid == request.auth.uid)) || isTeacher();
      allow create, delete: if isTeacher();
    }

    match /subscriptionCodes/{codeId} {
      allow get: if isAuthenticated();
      allow list: if isTeacher();
      allow update: if (isAuthenticated() && (resource.data.usedCount < resource.data.maxUses || resource.data.usedByUid == request.auth.uid)) || isTeacher();
      allow create, delete: if isTeacher();
    }

    // ===============================================================
    // Curriculum: Stages, Courses & Lectures
    // ===============================================================

    match /stages/{stageId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isTeacher();

      match /lectures/{lectureId} {
        allow read: if isAuthenticated();
        allow write: if isTeacher();
      }
    }

    match /lectures/{lectureId} {
      allow read: if true;
      allow write: if true;
    }

    match /booklets/{docId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    match /achievers/{docId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    match /announcements/{docId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // ===============================================================
    // Platform Settings & Admin Auth
    // ===============================================================

    match /adminUsers/{adminId} {
      allow read, write: if isTeacher();
    }

    match /settings/adminAuth {
      allow read, write: if isTeacher();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // ===============================================================
    // Audit Logs & Tamper-Evident Records
    // ===============================================================

    match /auditLogs/{logId} {
      allow read: if isTeacher();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit trail
    }

    // ===============================================================
    // Exams & Submissions
    // ===============================================================

    match /exams/{examId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    match /examSubmissions/{submissionId} {
      allow read: if isAuthenticated() && (resource.data.studentUid == request.auth.uid || isTeacher());
      allow create: if isAuthenticated() && request.resource.data.studentUid == request.auth.uid;
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }
  }
}
